# Plan: docs/plans/20-terminal.md (v3) · Colors: docs/plans/25-colors.md §10 R1 / §11 FINAL (Q-25.14).
# Source of truth: docs/plans/colors/frame/sainnhe-hard-hybrid.json — values copied exactly.
# Palette: sainnhe/gruvbox-material "hard" dark (autoload/gruvbox_material.vim, MIT), with one
# deliberate change ("fixed"): ANSI 8 = grey0 #7c6f64 instead of the near-background #32302f/#3c3836
# used by sainnhe's terminal gist and vlanx's port, so dim text (zsh-autosuggestions) stays
# readable: 3.37:1 instead of ~1.3:1 on #1d2021.
# Selected in config.ghostty with:  theme = gruvbox-material-hard-fixed

background = #1d2021
foreground = #d4be98
cursor-color = #d4be98

# Selection: sainnhe hard-dark `Visual` = bg3 #3c3836 with fg "none" (text keeps its own color).
selection-background = #3c3836
# Derived, not in the JSON: Ghostty's fallback for an unset selection-foreground is the WINDOW
# BACKGROUND (#1d2021 on #3c3836 = ~1.3:1, unreadable; src/renderer/generic.zig@v1.3.1).
# Q-B26 answer (keep each character's colour): `cell-foreground` = sainnhe's fg="none" semantics.
selection-foreground = cell-foreground

